<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="پارت ساز"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="کلمات رو خط به خط وارد کن. با هر بار زدن «ساخت پارت جدید»، یک پارت طولانی و بدون تکرار پشت‌سرهم ساخته می‌شه."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- words input card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="6"
                android:gravity="top|right"
                android:background="@drawable/bg_field"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_muted"
                android:padding="14dp"
                android:hint="سیب&#10;درخت&#10;آسمان&#10;رودخانه&#10;ستاره" />

            <TextView
                android:id="@+id/tvWordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۰ کلمه"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- history card (moved up, single-line items, tap to copy) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_red"
                    android:text="پاک کردن تاریخچه"
                    android:textColor="#FFD7D7"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="تاریخچه (۰)"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="با لمس هر پارت از تاریخچه، همون کپی می‌شه."
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- current part card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="پارت فعلی"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_orange"
                    android:text="کپی پارت"
                    android:textColor="#1A1A1A"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnNew"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_blue"
                    android:text="ساخت پارت جدید"
                    android:textColor="#0F0F1A"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:background="@drawable/bg_field"
                android:padding="14dp"
                android:text="هنوز پارتی ساخته نشده."
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
